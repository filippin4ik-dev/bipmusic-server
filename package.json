{
  "name": "bpmz-backend",
  "version": "1.0.0",
  "description": "bpMZ Music Streaming Service - Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npx prisma generate && tsx watch src/server.ts",
    "build": "npx prisma generate && tsc",
    "build:slim": "npx prisma generate && node scripts/build-slim.mjs",
    "start": "NODE_PATH=./release/runtime node --enable-source-maps release/app/server.mjs",
    "start:dist": "node --enable-source-maps dist/server.js",
    "prod:setup": "npx prisma generate && npx prisma db push && node dist/seed.js",
    "setup": "npx prisma generate && npx prisma db push && tsx src/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^11.16.0",
    "prisma": "^6.0.0",
    "uuid": "^10.0.0",
    "yauzl": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
