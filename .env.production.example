# =============================================================================
# bpMZ production config (bipmusic.ru).  Copy to .env on the VPS.
# Generate JWT secrets:   openssl rand -base64 48
# =============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Paths ./data/... are inside the API container (WORKDIR=/app → /app/data/...).
# На VPS данные на диске: /root/server/data (docker-compose монтирует в /app/data).

# SQLite. For Postgres, change `provider = "sqlite"` in prisma/schema.prisma
# and use a postgresql:// URL.
# Один файл на все деплои. Не меняй имя после заливки треков (иначе «пропадёт» каталог).
#
# Путь ОБЯЗАТЕЛЬНО абсолютный: относительный file:-путь Prisma резолвит от папки
# со схемой (/app/prisma), а не от рабочей папки процесса. Из-за этого
# file:./data/bpmz.db создавал базу в /app/prisma/data — внутри контейнера, мимо
# смонтированного тома, и она пропадала при каждой пересборке.
# Для локальной разработки (без Docker): DATABASE_URL="file:../data/bpmz.db"
DATABASE_URL="file:/app/data/bpmz.db"

# Strong, distinct secrets — 32+ chars each. NEVER commit real values.
JWT_SECRET=REPLACE_ME_WITH_48_CHAR_BASE64
JWT_REFRESH_SECRET=REPLACE_ME_WITH_ANOTHER_48_CHAR_BASE64
JWT_EXPIRY=30d
JWT_REFRESH_EXPIRY=180d

# Allow-list of origins that may call this API.  Server refuses to start in
# production if this contains `*`.  The iOS app uses the API directly with
# no Origin header, but a web admin or future website would need to be listed.
CORS_ORIGINS=https://bipmusic.ru

# Invite codes (comma-separated) — rotate often.
INVITE_CODES=bpmz_friends_only

# Initial admin account (created once on first boot via seed).
# In production the server REFUSES to start unless ADMIN_PASSWORD is set,
# is not "admin123", and is at least 10 characters.
#
# ADMIN_EMAIL must be "<ADMIN_NICKNAME>@echo.local": clients log in by nickname
# and map it to that address themselves, while /api/auth/login matches on email
# only. Any other domain here makes the admin account unreachable from the apps.
ADMIN_EMAIL=admin@echo.local
ADMIN_NICKNAME=admin
ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_ADMIN_PASSWORD

# Brute-force protection on /api/auth/login. All three are OFF by default so a
# small private instance can't lock out its own users; the global 300 req/min/IP
# limiter still applies. Uncomment to turn back on.
#LOGIN_RATE_LIMIT=20             # login requests per minute per IP
#LOGIN_MAX_FAILS_PER_EMAIL=5     # failed logins per account per 15 min
#LOGIN_MAX_FAILS_PER_IP=20       # failed logins per IP per 15 min

# Storage (auto-created on first run).
TRACKS_DIR=./data/tracks
COVERS_DIR=./data/covers
TMP_DIR=./data/tmp
APP_DIR=./data/app

# Публичный URL сайта — для ссылок на артистов, IPA и Diawi.
PUBLIC_BASE_URL=https://bipmusic.ru
APP_BUNDLE_ID=bipmusic.bip

# Токен с https://i.diawi.com/profile/api — админ грузит IPA из приложения,
# сервер сам выкладывает сборку. Без токена можно вставить ссылку Diawi вручную.
# DIAWI_TOKEN=

# Токен Яндекс Музыки для текста с таймкодами в админке.
# Можно не писать сюда: админ подключает аккаунт из приложения (Админка → трек → «С Яндекс Музыки»).
# YANDEX_MUSIC_TOKEN=

# bcrypt cost during registration (10–12). Default 11 — slightly faster on weak VPS vs 12.
# BCRYPT_ROUNDS=11